@startuml
title Christopher Columbus Travel - Modular Software Architecture

top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam package {
  BackgroundColor White
  BorderColor #334155
  FontColor #0F172A
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}

package "Christopher Columbus Travel" <<enterprise>> {
  package "Interaction" as InteractionLayer <<layer>> {
    package "MOD-CI\nCustomer Interaction" <<module>> {
      class CustomerInteraction <<interface>>
    }
    package "MOD-SI\nStaff Interaction" <<module>> {
      class StaffInteraction <<interface>> {
        +designPackageTravel()
        +procureStockCapacity()
        +prepareOrderedTravel()
        +maintainProductsAndServices()
      }
    }
    package "MOD-SUPI\nSupplier Interaction" <<module>> {
      class SupplierInteraction <<interface>>
      class SupplierAdapter <<adapter>>
    }
    StaffInteraction -[hidden]right- CustomerInteraction
    SupplierInteraction -[hidden]right- StaffInteraction
  }

  package "Core Business" as CoreBusinessLayer <<layer>> {
    package "MOD-TPD\nTravel Product Design" <<module>> {
      class TravelProductDesign <<interface>> {
        +composeIndividualTravel()
        +designPackageTravel()
        +checkItineraryPlausibility()
        +getItinerarySnapshot()
      }
    }
    package "MOD-PROC\nProcurement" <<module>> {
      class Procurement <<interface>> {
        +procureStockCapacity()
        +getCapacityConstraints()
        +getSourcingTerms()
        +checkStockAvailability()
        +allocateStockCapacity()
      }
      class ProcurementAdapter <<adapter>>
      class ProcurementSupplierPort <<required interface>> {
        +requestStockCapacity()
      }
    }
    package "MOD-SALES\nSales" <<module>> {
      class Sales <<interface>> {
        +createSalesOffer()
        +confirmAvailability()
        +acceptSalesOffer()
      }
    }
    package "MOD-EXEC\nTravel Execution" <<module>> {
      class TravelExecution <<interface>> {
        +prepareOrderedTravel()
        +issueTravelDocuments()
        +coordinateActiveTravel()
        +assistDuringOrAfterTravel()
      }
      class ExecutionSupplierPort <<required interface>> {
        +obtainFulfilmentConfirmation()
        +coordinateExecutionChange()
      }
    }
    Procurement -[hidden]right- TravelProductDesign
    Sales -[hidden]right- Procurement
    TravelExecution -[hidden]right- Sales
  }

  package "Resources" as ResourcesLayer <<layer>> {
    package "MOD-CM\nCustomer Management" <<module>> {
      class CustomerManagement <<interface>> {
        +getCustomerContext()
        +getAuthorisedRecipient()
        +maintainCustomerRecord()
      }
    }
    package "MOD-TPM\nTravel Product Management" <<module>> {
      class TravelProductManagement <<interface>> {
        +findTravelOptions()
        +findTravelServices()
        +getServiceConstraints()
        +getServiceSnapshots()
        +recordStockAvailability()
        +maintainProductsAndServices()
      }
      class TravelProductSupplierPort <<required interface>> {
        +obtainServiceDefinition()
      }
    }
    package "MOD-OM\nOrder Management" <<module>> {
      class OrderManagement <<interface>> {
        +getTravelContext()
        +createTravelOrder()
        +getTravelOrder()
        +secureRequiredServices()
        +applyPayment()
      }
      class OrderStockPort <<required interface>> {
        +allocateStockCapacity()
      }
    }
    TravelProductManagement -[hidden]right- CustomerManagement
    OrderManagement -[hidden]right- TravelProductManagement
  }

  package "Supporting Processes" as SupportingProcessesLayer <<layer>> {
    package "MOD-ACC\nAccounting" <<external module>> {
      class Accounting <<interface>> {
        +postCustomerPayment()
      }
    }
    package "MOD-REP\nReporting" <<external module>> {
      class Reporting <<interface>>
    }
    package "MOD-HR\nHuman Resources" <<external module>> {
      class HumanResources <<interface>>
    }
    Reporting -[hidden]right- Accounting
    HumanResources -[hidden]right- Reporting
  }

  InteractionLayer -[hidden]down- CoreBusinessLayer
  CoreBusinessLayer -[hidden]down- ResourcesLayer
  ResourcesLayer -[hidden]down- SupportingProcessesLayer

  CustomerInteraction -[hidden]down- TravelProductDesign
  StaffInteraction -[hidden]down- Procurement
  SupplierInteraction -[hidden]down- TravelExecution

  TravelProductDesign -[hidden]down- CustomerManagement
  Procurement -[hidden]down- TravelProductManagement
  TravelExecution -[hidden]down- OrderManagement

  CustomerManagement -[hidden]down- Accounting
  TravelProductManagement -[hidden]down- Reporting
  OrderManagement -[hidden]down- HumanResources

  CustomerInteraction .[norank].> TravelProductDesign
  CustomerInteraction .[norank].> Sales
  CustomerInteraction .[norank].> TravelExecution
  CustomerInteraction .[norank].> CustomerManagement
  CustomerInteraction .[norank].> TravelProductManagement
  CustomerInteraction .[norank].> OrderManagement

  StaffInteraction .[norank].> TravelProductDesign
  StaffInteraction .[norank].> Procurement
  StaffInteraction .[norank].> TravelExecution
  StaffInteraction .[norank].> TravelProductManagement

  TravelExecution .[norank].> OrderManagement
  TravelExecution .[norank].> CustomerManagement

  Sales .[norank].> CustomerManagement
  Sales .[norank].> TravelProductDesign
  Sales .[norank].> Procurement
  Sales .[norank].> TravelProductManagement
  Sales .[norank].> OrderManagement

  TravelProductDesign .[norank].> Procurement
  TravelProductDesign .[norank].> TravelProductManagement

  OrderManagement .[norank].> Accounting

  Procurement .[norank].> TravelProductManagement
  SupplierAdapter .[norank].|> ProcurementSupplierPort
  SupplierAdapter .[norank].|> ExecutionSupplierPort
  SupplierAdapter .[norank].|> TravelProductSupplierPort
  ProcurementAdapter .[norank].|> OrderStockPort
}

@enduml
