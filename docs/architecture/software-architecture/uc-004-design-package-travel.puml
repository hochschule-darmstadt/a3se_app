@startuml
title UC-004 Design Package Travel - Module Interaction
autonumber
actor "Seasonal Planner" as Planner
participant "MOD-SI\nStaff Interaction" as SI
participant "MOD-TPD\nTouristic Product Design" as TPD
participant "MOD-SP\nSeason Planning" as SP
participant "MOD-TPM\nTouristic Product Management" as TPM
participant "MOD-INV\nInventory" as INV

Planner -> SI: designPackageTravel(seasonRef, designGoals)
SI -> TPD: designPackageTravel(seasonRef, designGoals)
TPD -> SP: getSeasonPlan(seasonRef)
SP --> TPD: seasonPlan
TPD -> TPM: getProductStructures(designGoals)
TPM --> TPD: reusableStructures
TPD -> INV: getCapacityOutlook(seasonRef, productRefs)
INV --> TPD: capacityOutlook
TPD --> SI: packageDesign
SI --> Planner: reviewable package
@enduml
