@startuml
title UC-002 Obtain Ongoing Travel Assistance - Module Interaction
autonumber
actor Traveler
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-CARE\nCustomer Care" as CARE
participant "MOD-OM\nOrder Management" as OM
participant "MOD-CM\nPerson Management" as CM

Traveler -> CI: obtainOngoingAssistance(orderRef, request)
CI -> CARE: assistTraveler(orderRef, request)
CARE -> OM: getOrderContext(orderRef)
OM --> CARE: orderContext
CARE -> CM: getTravelerContext(travelerRef)
CM --> CARE: travelerContext
CARE --> CI: assistanceOutcome
CI --> Traveler: continued assistance
@enduml
