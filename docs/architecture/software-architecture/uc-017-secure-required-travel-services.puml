@startuml
title UC-017 Secure Required Travel Services - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-OM\nOrder Management" as OM
participant "MOD-INV\nInventory" as INV

Customer -> CI: secureRequiredServices(orderRef)
CI -> OM: secureRequiredServices(orderRef)
loop each order component
  OM -> INV: allocateStockItem(orderItemRef, stockCriteria)
  INV --> OM: allocationOutcome
end
OM --> CI: coherentAllocationState
CI --> Customer: secured or partial outcome
@enduml
