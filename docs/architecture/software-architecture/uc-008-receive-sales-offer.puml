@startuml
title UC-008 Receive a Sales Offer - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-SALES\nSales" as SALES
participant "MOD-CM\nCustomer Management" as CM
participant "MOD-TPD\nTouristic Product Design" as TPD
participant "MOD-TPM\nTouristic Product Management" as TPM
participant "MOD-INV\nInventory" as INV

Customer -> CI: requestSalesOffer(itineraryRef)
CI -> SALES: createSalesOffer(customerRef, itineraryRef)
SALES -> CM: getCustomerRole(customerRef)
CM --> SALES: customerRole
SALES -> TPD: getCompositionSnapshot(itineraryRef)
TPD --> SALES: compositionSnapshot
SALES -> TPM: getProductRepresentations(productItemRefs)
TPM --> SALES: productRepresentations
SALES -> INV: priceAvailableStock(stockNeeds)
INV --> SALES: pricedStock
SALES --> CI: versionedSalesOffer
CI --> Customer: offer, validity, and conditions
@enduml
