---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	check_intent(check_intent)
	select_candidates(select_candidates)
	validate_composition(validate_composition)
	emit_client_actions(emit_client_actions)
	__end__([<p>__end__</p>]):::last
	__start__ --> check_intent;
	check_intent -.-> __end__;
	check_intent -.-> select_candidates;
	select_candidates --> validate_composition;
	validate_composition -.-> __end__;
	validate_composition -.-> emit_client_actions;
	emit_client_actions --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
