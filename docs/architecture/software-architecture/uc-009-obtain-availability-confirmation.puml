@startuml
title UC-009 Obtain Availability Confirmation - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-SALES\nSales" as SALES
participant "MOD-INV\nInventory" as INV

Customer -> CI: confirmAvailability(offerRef)
CI -> SALES: confirmAvailability(offerRef)
SALES -> INV: confirmStockAvailability(stockItemRefs)
INV --> SALES: timeBoundAvailability
SALES --> CI: completeAvailabilityResult
CI --> Customer: availability and limitations
@enduml
