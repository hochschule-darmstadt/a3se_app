@startuml
title UC-009 Obtain Availability Confirmation - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-SALES\nSales" as SALES
participant "MOD-TPM\nTravel Product Management" as TPM
participant "MOD-PROC\nProcurement" as PROC

Customer -> CI: confirmAvailability(compositionVersion)
CI -> SALES: confirmAvailability(compositionVersion)
SALES -> TPM: getServiceSnapshots(serviceReferences)
TPM --> SALES: internalAvailabilityInputs
SALES -> PROC: checkStockAvailability(serviceReferences)
PROC --> SALES: remainingStockAvailability
SALES --> CI: completeTimeBoundResult
CI --> Customer: availability and limitations
@enduml
