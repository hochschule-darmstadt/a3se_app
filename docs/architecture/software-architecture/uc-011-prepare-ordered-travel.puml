@startuml
title UC-011 Prepare Ordered Travel - Module Interaction
autonumber
actor "Travel Advisor" as Advisor
participant "MOD-SI\nStaff Interaction" as SI
participant "MOD-CARE\nCustomer Care" as CARE
participant "MOD-OM\nOrder Management" as OM
participant "MOD-INV\nInventory" as INV
participant "MOD-SM\nSupplier Management" as SM

Advisor -> SI: prepareOrderedTravel(orderRef)
SI -> CARE: prepareOrderedTravel(orderRef)
CARE -> OM: getOrder(orderRef)
OM --> CARE: orderAndRoles
