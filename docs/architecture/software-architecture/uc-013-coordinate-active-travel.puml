@startuml
title UC-013 Coordinate Active Travel - Module Interaction
autonumber
actor Traveler
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-CARE\nCustomer Care" as CARE
participant "MOD-OM\nOrder Management" as OM
participant "MOD-SM\nPartner Management" as SM
participant "MOD-CM\nPerson Management" as CM

Traveler -> CI: coordinateActiveTravel(orderRef, event)
CI -> CARE: coordinateActiveTravel(orderRef, event)
CARE -> OM: getActiveOrderContext(orderRef)
OM --> CARE: activeOrderContext
CARE -> SM: getSupplierContacts(affectedOrgRoleRefs)
SM --> CARE: supplierContacts
CARE -> CM: getTravelerContext(travelerRef)
CM --> CARE: travelerContext
CARE --> CI: coordinatedOutcome
CI --> Traveler: actionable information
@enduml
