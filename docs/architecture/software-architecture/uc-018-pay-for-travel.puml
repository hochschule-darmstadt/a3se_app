@startuml
title UC-018 Pay for Travel - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-OM\nOrder Management" as OM
participant "MOD-ACC\nAccounting" as ACC

Customer -> CI: payForTravel(orderRef, paymentInstruction)
CI -> OM: applyPayment(orderRef, paymentInstruction)
OM -> ACC: postCustomerPayment(orderRef, paymentRecord)
ACC --> OM: accountingReference
OM --> CI: paymentOutcome and balance
CI --> Customer: receipt or pending outcome
@enduml
