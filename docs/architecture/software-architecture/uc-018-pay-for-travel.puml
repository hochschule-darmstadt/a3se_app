@startuml
title UC-018 Pay for Travel - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-OM\nOrder Management" as OM
participant "MOD-ACC\nAccounting contract" as ACC

Customer -> CI: payForTravel(orderReference, paymentIntent)
CI -> OM: applyPayment(orderReference, paymentIntent)
OM -> ACC: postCustomerPayment(orderReference, amount, attemptReference)
ACC --> OM: paymentPostingOutcome
OM -> OM: applyConfirmedPaymentExactlyOnce()
OM --> CI: balance and receiptReference
CI --> Customer: payment outcome
@enduml
