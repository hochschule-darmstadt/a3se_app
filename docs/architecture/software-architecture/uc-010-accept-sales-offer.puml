@startuml
title UC-010 Accept a Sales Offer - Module Interaction
autonumber
actor Customer
participant "MOD-CI\nCustomer Interaction" as CI
participant "MOD-SALES\nSales" as SALES
participant "MOD-OM\nOrder Management" as OM

Customer -> CI: acceptSalesOffer(offerRef, version)
CI -> SALES: acceptSalesOffer(offerRef, version, customerRef)
SALES -> OM: recordAcceptedOffer(offerSnapshot, acceptanceEvidence)
OM --> SALES: acceptedOfferRecord
SALES --> CI: acceptanceOutcome
CI --> Customer: accepted offer confirmation
@enduml
