@startuml
title UC-006 Procure Stock Services - Module Interaction
autonumber
actor Purchaser
participant "MOD-SI\nStaff Interaction" as SI
participant "MOD-PROC\nProcurement" as PROC
participant "MOD-SM\nSupplier Management" as SM
participant "MOD-TPM\nTouristic Product Management" as TPM
participant "MOD-INV\nInventory" as INV

Purchaser -> SI: procureStockCapacity(procurementRequest)
SI -> PROC: procureStockCapacity(procurementRequest)
PROC -> SM: getSupplierRole(supplierRef)
SM --> PROC: supplierRole
PROC -> TPM: getProductItem(productItemRef)
TPM --> PROC: productItem
PROC -> INV: recordStockItems(productItemRef, commitment)
INV --> PROC: recordedStock
PROC --> SI: procurementOutcome
SI --> Purchaser: committed capacity
@enduml
