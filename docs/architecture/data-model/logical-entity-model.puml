@startuml
title Christopher Columbus Travel - Logical Entity Model

top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam package {
  BackgroundColor White
  BorderColor #334155
  FontColor #0F172A
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}

package "Christopher Columbus Travel" <<enterprise>> {
  package "Core Business" as CoreLayer <<layer>> {
    package "MOD-TPD\nTravel Product Design" <<module>> {
      class Itinerary <<entity>> {
        itineraryId: Identifier
        compositionType: CompositionType
        version: Version
        status: ItineraryStatus
        startDate: Date
        endDate: Date
      }
      class TravelComponent <<entity>> {
        componentId: Identifier
        sequence: Number
        componentType: ComponentType
        startAt: DateTime
        endAt: DateTime
        status: ComponentStatus
      }
    }

    package "MOD-PROC\nProcurement" <<module>> {
      class Supplier <<entity>> {
        supplierId: Identifier
        name: Text
        status: PartyStatus
      }
      class Intermediary <<entity>> {
        intermediaryId: Identifier
        name: Text
        status: PartyStatus
      }
      class StockCapacity <<entity>> {
        capacityId: Identifier
        serviceId: Identifier
        quantity: Quantity
        validFrom: Date
        validUntil: Date
        purchasePrice: Money
        status: CapacityStatus
      }
      class SourcingArrangement <<entity>> {
        arrangementId: Identifier
        serviceScope: Text
        validFrom: Date
        validUntil: Date
        priceTerms: Text
        accessMethod: Text
        limits: Text
        status: ArrangementStatus
      }
    }

    package "MOD-SALES\nSales" <<module>> {
      class SalesOffer <<entity>> {
        offerId: Identifier
        version: Version
        salePrice: Money
        validUntil: DateTime
        conditions: Text
        availabilityStatus: AvailabilityStatus
        status: OfferStatus
      }
      class OfferLine <<entity>> {
        offerLineId: Identifier
        sequence: Number
        serviceDescription: Text
        salePrice: Money
        conditions: Text
      }
    }

    package "MOD-EXEC\nTravel Execution" <<module>> {
      class ExecutionCase <<entity>> {
        executionCaseId: Identifier
        status: ExecutionStatus
        readiness: ReadinessStatus
        startedAt: DateTime
        completedAt: DateTime
      }
      class TravelDocument <<entity>> {
        documentId: Identifier
        documentType: DocumentType
        version: Version
        releaseStatus: ReleaseStatus
        issuedAt: DateTime
      }
      class ExecutionEvent <<entity>> {
        eventId: Identifier
        eventType: EventType
        occurredAt: DateTime
        status: EventStatus
        resolution: Text
      }
    }
  }

  package "Resources" as ResourcesLayer <<layer>> {
    package "MOD-CM\nCustomer Management" <<module>> {
      class Customer <<entity>> {
        customerId: Identifier
        displayName: Text
        contactDetails: ContactDetails
        consentStatus: ConsentStatus
        recordStatus: RecordStatus
      }
      class Traveler <<entity>> {
        travelerId: Identifier
        name: Text
        travelDetails: TravelerDetails
        recordStatus: RecordStatus
      }
    }

    package "MOD-TPM\nTravel Product Management" <<module>> {
      class TravelProduct <<entity>> {
        productId: Identifier
        name: Text
        description: Text
        version: Version
        validFrom: Date
        validUntil: Date
        status: DefinitionStatus
      }
      class TravelService <<entity>> {
        serviceId: Identifier
        serviceType: ServiceType
        name: Text
        description: Text
        version: Version
        validFrom: Date
        validUntil: Date
        status: DefinitionStatus
      }
      class AvailabilityInput <<entity>> {
        availabilityInputId: Identifier
        availabilityType: AvailabilityType
        quantity: Quantity
        validFrom: DateTime
        validUntil: DateTime
        status: AvailabilityStatus
      }
    }

    package "MOD-OM\nOrder Management" <<module>> {
      class TravelOrder <<entity>> {
        orderId: Identifier
        orderReference: Text
        createdAt: DateTime
        totalPrice: Money
        currency: Currency
        status: OrderStatus
        securedStatus: SecuredStatus
        balanceDue: Money
      }
      class OrderLine <<entity>> {
        orderLineId: Identifier
        sequence: Number
        serviceDescription: Text
        salePrice: Money
        status: OrderLineStatus
      }
      class Reservation <<entity>> {
        reservationId: Identifier
        externalReference: Text
        status: ReservationStatus
        heldUntil: DateTime
        attemptReference: Text
      }
      class Payment <<entity>> {
        paymentId: Identifier
        purpose: PaymentPurpose
        amount: Money
        currency: Currency
        attemptReference: Text
        status: PaymentStatus
        confirmedAt: DateTime
      }
    }
  }

  CoreLayer -[hidden]down- ResourcesLayer

  Itinerary -[hidden]right- Supplier
  Supplier -[hidden]right- SalesOffer
  SalesOffer -[hidden]right- ExecutionCase
  Customer -[hidden]right- TravelProduct
  TravelProduct -[hidden]right- TravelOrder

  Itinerary "1" *-- "1..*" TravelComponent : components
  SalesOffer "1" *-- "1..*" OfferLine : lines
  ExecutionCase "1" *-- "0..*" TravelDocument : documents
  ExecutionCase "1" *-- "0..*" ExecutionEvent : events
  Customer "0..*" -- "0..*" Traveler : maintains
  TravelProduct "0..*" -- "1..*" TravelService : uses
  TravelService "1" *-- "0..*" AvailabilityInput : availability inputs
  TravelOrder "1" *-- "1..*" OrderLine : lines
  TravelOrder "1" *-- "0..*" Reservation : reservations
  TravelOrder "1" *-- "0..*" Payment : payments
  OrderLine "1" -- "0..*" Reservation : secured by

  TravelComponent .[norank].> TravelService : <<reference by ID>>
  TravelService .[norank].> Supplier : <<reference by ID>>
  StockCapacity .[norank].> TravelService : <<reference by ID>>
  SourcingArrangement .[norank].> TravelService : <<reference by ID>>
  SourcingArrangement .[norank].> Supplier : <<sourcing party ID>>
  SourcingArrangement .[norank].> Intermediary : <<sourcing party ID>>
  SalesOffer .[norank].> Customer : <<reference by ID>>
  SalesOffer .[norank].> Itinerary : <<snapshot>>
  SalesOffer .[norank].> TravelProduct : <<snapshot>>
  OfferLine .[norank].> TravelService : <<snapshot>>
  TravelOrder .[norank].> Customer : <<reference by ID>>
  TravelOrder .[norank].> Traveler : <<reference by ID>>
  TravelOrder .[norank].> SalesOffer : <<snapshot>>
  TravelOrder .[norank].> Itinerary : <<snapshot>>
  OrderLine .[norank].> TravelService : <<snapshot>>
  Reservation .[norank].> StockCapacity : <<sourcing route ID>>
  Reservation .[norank].> SourcingArrangement : <<sourcing route ID>>
  ExecutionCase .[norank].> TravelOrder : <<projection>>
}

legend bottom
  Solid = association inside one owned module model
  Dashed = conceptual cross-module relationship
  Cross-module relationships do not imply database foreign keys
endlegend

@enduml
