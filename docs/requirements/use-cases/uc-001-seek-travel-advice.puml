@startuml uc-001-seek-travel-advice
title UC-001 Seek Travel Advice - agentic chatbot task flow

skinparam shadowing false
skinparam activity {
  BackgroundColor #F7F7F7
  BorderColor #333333
  DiamondBackgroundColor #FFF4CC
  DiamondBorderColor #8A6D1D
}

|ACT-001 Customer|
start
:MSS 1 - Message the Automated Travel Advisor\nwith a question, goal, or action request;

|System|
:MSS 2 - Retrieve confirmed context\nand check available authority;
:MSS 3 - Answer or identify information,\nauthorization, or decision needed;
if (Context, authority, and\ninformation sufficient?) then (yes)
else (no - EXT 2-4)
  :Identify what is needed;
  :Preserve the last confirmed state;
  :Communicate the missing need\nwithout inferring it;
  stop
endif

repeat
  if (Action requested?) then (yes)
    :MSS 4 - Present intended action\nand invoke an authorized operation;
  else (answer only)
    :Present answer and relevant sources;
  endif
  :MSS 5 - Report proposed, awaiting input,\nin progress, confirmed, failed,\nor uncertain state;
  if (Answer or action available?) then (yes)
  else (no - EXT 4-5)
    :Record the partial or uncertain result;
    :Avoid presenting success;
    :Offer retry, revision, or\nhuman-assistance path;
    stop
  endif

  |ACT-001 Customer|
  :MSS 6 - Review answer or\nresulting state;
  if (Result confirmed?) then (yes)
    break
  else (no - EXT 6)
    |System|
    :Preserve the confirmed baseline;
    :Continue from affected information;
    |ACT-001 Customer|
    :Refine goal or request another action;
    |System|
    :MSS 3 - Validate revised information;
  endif
repeat while (Further refinement?) is (yes)

|System|
:MSS 7 - Record confirmed outcomes, provenance,\nand unresolved next steps;
:Communicate them to affected actors;
stop

legend bottom
Textual UC-001 is authoritative.
MSS = main success scenario; EXT = extension.
endlegend
@enduml
